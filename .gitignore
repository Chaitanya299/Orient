# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp
*~

# Claude Code local (machine-specific, never commit)
.claude/settings.local.json

# Orient runtime marker, if it ever lands in-repo (normally in XDG state dir)
.init-nudged

# Internal publishing notes — kept local, not shipped in the public repo
PUBLISHING.md

# Deterministic test suite — kept local (runnable with `npm test`), not committed
# or shipped. The `repo-test` agent covers end-to-end verification on demand.
tests/

# Local install artifacts and strays — never commit. `.opencode/` and `.agents/`
# are what orient *installs into* a consumer repo; the source lives in `opencode/`
# and `codex/`. `.claude/` is local agent/settings config. `*.vsix` catches stray
# editor-extension bundles. These block a careless `git add .` from committing junk.
*.vsix
.claude/
.opencode/
.agents/

# npm
node_modules/
*.tgz
package-lock.json

# Secrets — never commit. orient generates none of these; these rules protect
# anyone who forks this repo or works alongside it from an accidental leak.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
*.credentials
.aws/
.ssh/
secrets/
